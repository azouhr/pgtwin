    [ -n "$TARGET_PGPASSFILE" ] && echo "  .pgpass:        $TARGET_PGPASSFILE"

    echo ""
    echo -e "${BOLD}VIP Resources:${RESET}"
    if [ -n "$PRODUCTION_VIP_RESOURCE" ]; then
        local prod_ip=$(get_vip_address "$PRODUCTION_VIP_RESOURCE")
        if [ -n "$prod_ip" ]; then
            echo "  Production VIP: ${PRODUCTION_VIP_RESOURCE} (${prod_ip})"
        else
            echo "  Production VIP: ${PRODUCTION_VIP_RESOURCE}"
        fi
    else
        echo "  Production VIP: <not set>"
    fi

    if [ -n "$TARGET_VIP_RESOURCE" ]; then
        local target_ip=$(get_vip_address "$TARGET_VIP_RESOURCE")
        if [ -n "$target_ip" ]; then
            echo "  Target VIP:     ${TARGET_VIP_RESOURCE} (${target_ip})"
        else
            echo "  Target VIP:     ${TARGET_VIP_RESOURCE}"
        fi
    else
        echo "  Target VIP:     <not set>"
    fi

    echo ""
    echo -e "${BOLD}Database Configuration:${RESET}"
    if [ -n "$DATABASES" ]; then
