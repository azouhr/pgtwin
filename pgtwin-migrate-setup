    echo ""
    echo -e "${BOLD}Source Cluster:${RESET}"
    echo "  Cluster:        $SOURCE_CLUSTER"
    if [ -n "$SOURCE_REPLICATION_VIP" ]; then
        local source_rep_vip_resource=$(get_vip_resource_by_ip "$SOURCE_REPLICATION_VIP")
        if [ -n "$source_rep_vip_resource" ]; then
            echo "  Replication VIP: $SOURCE_REPLICATION_VIP ($source_rep_vip_resource)"
        else
            echo "  Replication VIP: $SOURCE_REPLICATION_VIP"
        fi
    fi
    [ -n "$SOURCE_PGHOME" ] && echo "  PGHOME:         $SOURCE_PGHOME"
    [ -n "$SOURCE_PGPASSFILE" ] && echo "  .pgpass:        $SOURCE_PGPASSFILE"

    echo ""
    echo -e "${BOLD}Target Cluster:${RESET}"
    echo "  Cluster:        $TARGET_CLUSTER"
    if [ -n "$TARGET_REPLICATION_VIP" ]; then
        local target_rep_vip_resource=$(get_vip_resource_by_ip "$TARGET_REPLICATION_VIP")
        if [ -n "$target_rep_vip_resource" ]; then
            echo "  Replication VIP: $TARGET_REPLICATION_VIP ($target_rep_vip_resource)"
