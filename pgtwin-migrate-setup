#######################################################################
# Generate Configuration Files
#######################################################################

generate_config_file() {
    local file="$1"

    cat > "$file" <<EOF
# pgtwin-migrate configuration file
# Generated by $SCRIPT_NAME v$VERSION
# Date: $(date '+%Y-%m-%d %H:%M:%S')
#
# This file can be sourced by shell scripts to access configuration variables
# Example: source $file

# Resource name
RESOURCE_NAME="$RESOURCE_NAME"

# Source cluster configuration
SOURCE_CLUSTER="$SOURCE_CLUSTER"
SOURCE_REPLICATION_VIP="$SOURCE_REPLICATION_VIP"
SOURCE_PGHOME="$SOURCE_PGHOME"
SOURCE_PGPASSFILE="$SOURCE_PGPASSFILE"
SOURCE_NODE_ROLE="$SOURCE_NODE_ROLE"

# Target cluster configuration
TARGET_CLUSTER="$TARGET_CLUSTER"
TARGET_REPLICATION_VIP="$TARGET_REPLICATION_VIP"
TARGET_PGHOME="$TARGET_PGHOME"
TARGET_PGPASSFILE="$TARGET_PGPASSFILE"

# VIP resources
PRODUCTION_VIP_RESOURCE="$PRODUCTION_VIP_RESOURCE"
TARGET_VIP_RESOURCE="$TARGET_VIP_RESOURCE"
ORIGINAL_PRODUCTION_VIP_IP="$ORIGINAL_PRODUCTION_VIP_IP"
ORIGINAL_TARGET_VIP_IP="$ORIGINAL_TARGET_VIP_IP"

# Database configuration
DATABASES="$DATABASES"
PGDATABASE="$PGDATABASE"
PGPORT="$PGPORT"
MIGRATION_DBUSER="$MIGRATION_DBUSER"

# Logical replication settings
PUBLICATION_NAME="$PUBLICATION_NAME"
SUBSCRIPTION_NAME="$SUBSCRIPTION_NAME"
REPLICATION_SLOT_NAME="$REPLICATION_SLOT_NAME"
REVERSE_PUBLICATION_NAME="$REVERSE_PUBLICATION_NAME"
REVERSE_SUBSCRIPTION_NAME="$REVERSE_SUBSCRIPTION_NAME"
REVERSE_REPLICATION_SLOT_NAME="$REVERSE_REPLICATION_SLOT_NAME"

# Monitoring settings
LAG_THRESHOLD="$LAG_THRESHOLD"

# Advanced settings
CUTOVER_READY="$CUTOVER_READY"
CUTOVER_DEBUG="$CUTOVER_DEBUG"
EOF

    chmod 600 "$file"
    print_success "Configuration file written: $file"
}

generate_crm_file() {
    local file="$1"

    cat > "$file" <<EOF
# Pacemaker CRM configuration for pgtwin-migrate
# Generated by $SCRIPT_NAME v$VERSION
# Date: $(date '+%Y-%m-%d %H:%M:%S')
#
# To apply this configuration:
#   crm configure load update $file
#
# WARNING: Review and customize before applying to production!

primitive $RESOURCE_NAME pgtwin-migrate \\
    params \\
        source_cluster="$SOURCE_CLUSTER" \\
        target_cluster="$TARGET_CLUSTER" \\
        source_replication_vip="$SOURCE_REPLICATION_VIP" \\
        target_replication_vip="$TARGET_REPLICATION_VIP" \\
EOF

    # Add optional VIP resources if specified
    if [ -n "$PRODUCTION_VIP_RESOURCE" ]; then
        echo "        production_vip_resource=\"$PRODUCTION_VIP_RESOURCE\" \\" >> "$file"
    fi

    if [ -n "$TARGET_VIP_RESOURCE" ]; then
        echo "        target_vip_resource=\"$TARGET_VIP_RESOURCE\" \\" >> "$file"
    fi

    # Add original VIP IPs for safe rollback
    if [ -n "$ORIGINAL_PRODUCTION_VIP_IP" ]; then
        echo "        original_production_vip_ip=\"$ORIGINAL_PRODUCTION_VIP_IP\" \\" >> "$file"
    fi

    if [ -n "$ORIGINAL_TARGET_VIP_IP" ]; then
        echo "        original_target_vip_ip=\"$ORIGINAL_TARGET_VIP_IP\" \\" >> "$file"
    fi

    # Add database configuration
    if [ -n "$DATABASES" ]; then
        echo "        databases=\"$DATABASES\" \\" >> "$file"
    else
        echo "        databases=\"$PGDATABASE\" \\" >> "$file"
    fi

    cat >> "$file" <<EOF
        pgport="$PGPORT" \\
        migration_dbuser="$MIGRATION_DBUSER" \\
EOF

    # Add custom replication object names if specified
    if [ -n "$PUBLICATION_NAME" ]; then
        cat >> "$file" <<EOF
        publication_name="$PUBLICATION_NAME" \\
        subscription_name="$SUBSCRIPTION_NAME" \\
        replication_slot_name="$REPLICATION_SLOT_NAME" \\
EOF
    fi

    # Add monitoring settings
    cat >> "$file" <<EOF
        lag_threshold="$LAG_THRESHOLD" \\
EOF

    # Add optional PostgreSQL environment settings
    if [ -n "$SOURCE_PGHOME" ]; then
        echo "        source_pghome=\"$SOURCE_PGHOME\" \\" >> "$file"
    fi

    if [ -n "$TARGET_PGHOME" ]; then
        echo "        target_pghome=\"$TARGET_PGHOME\" \\" >> "$file"
    fi

    if [ -n "$SOURCE_PGPASSFILE" ]; then
        echo "        source_pgpassfile=\"$SOURCE_PGPASSFILE\" \\" >> "$file"
    fi

    if [ -n "$TARGET_PGPASSFILE" ]; then
        echo "        target_pgpassfile=\"$TARGET_PGPASSFILE\" \\" >> "$file"
    fi

    # Add advanced settings
    cat >> "$file" <<EOF
        source_node_role="$SOURCE_NODE_ROLE" \\
        cutover_ready="false" \\
        cutover_debug="$CUTOVER_DEBUG" \\
    op start timeout="300s" \\
    op stop timeout="60s" \\
    op monitor interval="30s" timeout="60s"
EOF

    print_success "CRM configuration file written: $file"
    echo ""
    print_info "Next steps:"
    echo "  1. Review the CRM configuration: cat $file"
    echo "  2. Verify cluster is ready: crm status"
    echo "  3. Apply configuration: crm configure load update $file"
    echo "  4. Start migration: crm resource start $RESOURCE_NAME"
    echo "  5. When ready to fail over the migration:"
    echo "     crm resource update $RESOURCE_NAME cutover_ready=true"
}

#######################################################################
# Main Program
#######################################################################

main() {
    # Parse command-line arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            --config)
                CONFIG_FILE="$2"
                shift 2
                ;;
            --help|-h)
                cat <<EOF
Usage: $SCRIPT_NAME [OPTIONS]

Interactive setup wizard for pgtwin-migrate

OPTIONS:
    --config FILE    Load default values from configuration file
    --help, -h       Show this help message

EXAMPLES:
    # First-time setup
    $SCRIPT_NAME

    # Load existing configuration and modify
    $SCRIPT_NAME --config migration-forward.conf

OUTPUT:
    The script generates two files:
    1. Configuration file (.conf) - Sourceable shell script with variables
    2. CRM configuration (.crm)   - Pacemaker configuration snippet

DOCUMENTATION:
    See README-pgtwin-migrate.md for detailed migration guide

EOF
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done

    # Print banner
    print_banner

    # Load configuration file if specified
    if [ -n "$CONFIG_FILE" ]; then
        load_config_file "$CONFIG_FILE"

        # Map config file variables to internal script variables
        if [ -n "${SOURCE_REP+x}" ]; then
            SOURCE_REPLICATION_VIP="$SOURCE_REP"
        fi
        if [ -n "${TARGET_REP+x}" ]; then
            TARGET_REPLICATION_VIP="$TARGET_REP"
        fi
        if [ -n "${PGUSER+x}" ]; then
            MIGRATION_DBUSER="$PGUSER"
        fi
        if [ -n "${SOURCE_PORT+x}" ]; then
            PGPORT="$SOURCE_PORT"
        fi
        if [ -n "${PGPASS_FILE+x}" ]; then
            export PGPASSFILE="$PGPASS_FILE"
        fi
    fi

    # Interactive prompts
    prompt_required_parameters

    # Check cluster health after cluster names are selected
    echo ""
    print_section "Cluster Health Check"
    echo ""

    local source_healthy=false
    local target_healthy=false

    if check_cluster_health "$SOURCE_CLUSTER" "Source cluster ($SOURCE_CLUSTER)"; then
        source_healthy=true
    fi

    echo ""

    if check_cluster_health "$TARGET_CLUSTER" "Target cluster ($TARGET_CLUSTER)"; then
        target_healthy=true
    fi

    echo ""

    if [ "$source_healthy" = false ] || [ "$target_healthy" = false ]; then
        print_error "One or both clusters are not healthy"
        print_warning "Please fix cluster issues before proceeding with migration setup"
        echo ""
        print_info "Troubleshooting steps:"
        explain "1. Check cluster status: crm status"
        explain "2. Check PostgreSQL logs on cluster nodes"
        explain "3. Verify Pacemaker configuration"
        explain "4. See pgtwin documentation for common issues"
        echo ""
        local proceed=$(prompt_yesno "Continue anyway (not recommended)?" "n")
        if [ "$proceed" != "y" ]; then
            print_info "Setup cancelled - fix cluster issues and try again"
            exit 1
        fi
    else
        print_success "Both clusters are healthy - proceeding with setup"
    fi

    prompt_vip_resources
    prompt_database_configuration
    prompt_replication_settings
    prompt_monitoring_settings
    prompt_postgresql_environment
    prompt_advanced_settings
    prompt_output_files

    # Show summary
    print_summary

    # Confirm before generating files
    echo ""
    local confirm=$(prompt_yesno "Generate configuration files?" "y")

    if [ "$confirm" != "y" ]; then
        print_info "Configuration cancelled"
        exit 0
    fi

    # Generate files
    echo ""
    print_section "Generating Configuration Files"
    echo ""

    generate_config_file "$OUTPUT_CONFIG"
    generate_crm_file "$OUTPUT_CRM"

    echo ""
    print_success "Setup complete!"
    echo ""
    print_info "Configuration saved to:"
    echo "  - $OUTPUT_CONFIG (reusable config)"
    echo "  - $OUTPUT_CRM (Pacemaker CRM)"
    echo ""
    print_warning "IMPORTANT:"
    echo "  1. Review both files before applying"
    echo "  2. Ensure .pgpass files are configured on all nodes"
    echo "  3. Verify wal_level=logical on both clusters"
    echo "  4. Test in non-production first!"
    echo ""
}

# Run main program
main "$@"
